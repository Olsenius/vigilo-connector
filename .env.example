# Kopier til .env og fyll inn. Bare TS_AUTHKEY er påkrevd.

# Tailscale auth key (admin-konsollen → Settings → Keys). Brukes bare første gang.
TS_AUTHKEY=
# Gir adressen https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=vigilo

# Image. Bytt til din egen fork om du bygger selv.
VIGILO_IMAGE=ghcr.io/olsenius/vigilo-connector:latest

# Tomt = genereres og vises i loggen første gang
# (senere: docker exec vigilo-gateway vigilo-gateway show-password).
ADMIN_PASSWORD=

# Valgfri fast token for klienter uten OAuth (minst 32 tegn: openssl rand -hex 32).
API_TOKEN=

# Valgfritt: Vigilo-nøklene fra Android-appen. Kan også legges inn på /setup.
VIGILO_CLIENT_ID=
VIGILO_CLIENT_SECRET=

# Tomt = hentes automatisk fra Tailscale.
PUBLIC_URL=
